{% comment %}
  Renders the packaging option (coffret) as visual cards, each with a miniature
  of the coffret. A coffret with no available variant at all stays selectable so
  its photos can be seen (gallery update, plus an inline preview on mobile where
  the gallery is off screen), but it wears a "Bientôt de retour" band and the add
  to cart button switches to sold out. It comes back automatically as soon as one
  of its variants is in stock again.

  Keeps Dawn's radio markup (ids, names, data attributes) so variant-selects and
  product-info keep working.

  Accepts:
  - product: {Object} product object.
  - option: {Object} product_option object of the packaging option.

  Usage:
  {% render 'audio-keepsake-coffret-picker', product: product, option: option %}
{% endcomment %}
{%- liquid
  assign product_form_id = 'product-form-' | append: section.id
  assign option_index = option.position | minus: 1
  assign sold_out_count = 0
  assign in_stock_count = 0
  assign in_stock_name = ''
  assign selected_sold_out_name = ''
  assign selected_sold_out_image = null
-%}
<fieldset class="js product-form__input product-form__input--coffret">
  <legend class="form__label">{{ option.name }}</legend>
  <div class="coffret-picker">
    {%- for value in option.values -%}
      {%- liquid
        assign value_name = value.name
        assign value_image = null
        assign value_in_stock = false

        for variant in product.variants
          if variant.options[option_index] == value_name
            if value_image == null and variant.featured_media
              assign value_image = variant.featured_media.preview_image
            endif
            if variant.available
              assign value_in_stock = true
            endif
          endif
        endfor

        if value_in_stock
          assign in_stock_count = in_stock_count | plus: 1
          assign in_stock_name = value_name
        else
          assign sold_out_count = sold_out_count | plus: 1
          if value.selected
            assign selected_sold_out_name = value_name
            assign selected_sold_out_image = value_image
          endif
        endif

        assign input_id = section.id | append: '-' | append: option.position | append: '-' | append: forloop.index0
        assign input_name = option.name | append: '-' | append: option.position
      -%}
      <input
        type="radio"
        id="{{ input_id }}"
        name="{{ input_name | escape }}"
        value="{{ value | escape }}"
        form="{{ product_form_id }}"
        {% if value.selected %}
          checked
        {% endif %}
        class="{% if value.available == false %}disabled{% endif %}{% unless value_in_stock %} coffret-sold-out{% endunless %}"
        data-product-url="{{ value.product_url }}"
        data-option-value-id="{{ value.id }}"
      >
      <label for="{{ input_id }}" class="coffret-choice">
        <span class="coffret-choice__media">
          {%- if value_in_stock == false -%}
            <span class="coffret-choice__band">Bientôt de retour</span>
          {%- endif -%}
          {%- if value_image -%}
            {{
              value_image
              | image_url: width: 360
              | image_tag:
                widths: '180, 270, 360',
                sizes: '(min-width: 990px) 16rem, 30vw',
                loading: 'lazy',
                alt: '',
                class: 'coffret-choice__image'
            }}
          {%- endif -%}
        </span>
        <span class="coffret-choice__name">{{ value }}</span>
        {%- if value_in_stock == false -%}
          <span class="visually-hidden">{{ 'products.product.sold_out' | t }}</span>
        {%- elsif value.available == false -%}
          <span class="visually-hidden">{{ 'products.product.variant_sold_out_or_unavailable' | t }}</span>
        {%- endif -%}
      </label>
    {%- endfor -%}
  </div>

  {%- if selected_sold_out_name != blank -%}
    {%- liquid
      # "Le coffret noir" reads well whether or not the value already starts with "Coffret".
      assign sold_out_label = selected_sold_out_name | downcase
      if sold_out_label contains 'coffret'
        assign sold_out_label = 'le ' | append: sold_out_label
      else
        assign sold_out_label = 'le coffret ' | append: sold_out_label
      endif
      assign in_stock_label = in_stock_name | downcase
      if in_stock_label contains 'coffret'
        assign in_stock_label = 'le ' | append: in_stock_label
      else
        assign in_stock_label = 'le coffret ' | append: in_stock_label
      endif
    -%}
    {%- if selected_sold_out_image -%}
      <figure class="coffret-picker__preview">
        {{
          selected_sold_out_image
          | image_url: width: 900
          | image_tag:
            widths: '450, 675, 900',
            sizes: 'calc(100vw - 3rem)',
            loading: 'lazy',
            alt: selected_sold_out_name,
            class: 'coffret-picker__preview-image'
        }}
        <figcaption class="coffret-picker__preview-caption">{{ selected_sold_out_name }} · Bientôt de retour</figcaption>
      </figure>
    {%- endif -%}
    <p class="coffret-picker__note" role="status">
      {{ sold_out_label | capitalize }} est momentanément épuisé et revient très bientôt.
      {%- if in_stock_count == 1 %}
        {{ in_stock_label | capitalize }} est disponible dès aujourd’hui, avec le même soin.
      {%- elsif in_stock_count > 1 %}
        Les autres coffrets sont disponibles dès aujourd’hui.
      {%- endif -%}
    </p>
  {%- elsif sold_out_count > 0 and in_stock_count > 0 -%}
    <p class="coffret-picker__note">
      {%- if sold_out_count == 1 -%}
        Un coffret est momentanément épuisé : découvrez-le, il revient très bientôt.
      {%- else -%}
        Certains coffrets sont momentanément épuisés : découvrez-les, ils reviennent très bientôt.
      {%- endif -%}
    </p>
  {%- endif -%}
</fieldset>
