{% comment %}
  Renders the post-add personalization panel for the audio keepsake cart line.

  Accepts:
  - item: Line item object
  - line_index: 1-based cart line index
  - line_key: Shopify line item key
  - variant_id: Variant id
  - audio_mode: voice | ai | voice_music
  - audio_option_value: Selected audio option value
  - duration_value: Selected duration option value
  - packaging_value: Selected packaging option value
{% endcomment %}
{%- liquid
  assign existing_file = item.properties['Fichier audio']
  assign existing_brief = item.properties['Brief créatif']
  assign existing_notes = item.properties['Notes complémentaires']

  assign needs_file = false
  assign needs_brief = false

  if audio_mode == 'voice' or audio_mode == 'voice_music'
    assign needs_file = true
  endif

  if audio_mode == 'ai' or audio_mode == 'voice_music'
    assign needs_brief = true
  endif

  assign line_complete = true
  if needs_file and existing_file == blank
    assign line_complete = false
  endif
  if needs_brief and existing_brief == blank
    assign line_complete = false
  endif

  assign status_label = 'À compléter'
  if line_complete
    assign status_label = 'Prêt pour la suite'
  endif
-%}

<audio-keepsake-cart-panel
  class="audio-keepsake-cart"
  data-line="{{ line_index }}"
  data-line-key="{{ line_key | escape }}"
  data-variant-id="{{ variant_id }}"
  data-quantity="{{ item.quantity }}"
  data-mode="{{ audio_mode }}"
  data-complete="{{ line_complete }}"
  data-existing-properties='{{ item.properties | json | escape }}'
  data-required-file-message="Ajoutez votre fichier audio pour continuer."
  data-required-brief-message="Décrivez votre intention pour continuer."
  data-generic-error-message="Une erreur est survenue. Réessayez dans quelques instants."
  data-success-message="Votre personnalisation a bien été enregistrée."
  data-cloudinary-cloud-name="{{ settings.cloudinary_cloud_name | escape }}"
  data-cloudinary-upload-preset="{{ settings.cloudinary_upload_preset | escape }}"
  data-upload-error-message="L'envoi du fichier a échoué. Vérifiez votre connexion et réessayez."
  data-upload-size-error-message="Le fichier est trop volumineux (max 100 Mo). Choisissez un fichier plus petit."
>
  <div class="audio-keepsake-cart__header">
    <span class="audio-keepsake-cart__status" data-status-badge>{{ status_label }}</span>
  </div>

  <div class="audio-keepsake-cart__summary">
    <div class="audio-keepsake-cart__summary-item">
      <span>Type audio</span>
      <strong>{{ audio_option_value }}</strong>
    </div>
    {%- if duration_value != blank -%}
      <div class="audio-keepsake-cart__summary-item">
        <span>Durée</span>
        <strong>{{ duration_value }}</strong>
      </div>
    {%- endif -%}
    {%- if packaging_value != blank -%}
      <div class="audio-keepsake-cart__summary-item">
        <span>Packaging</span>
        <strong>{{ packaging_value }}</strong>
      </div>
    {%- endif -%}
  </div>

  <div class="audio-keepsake-cart__fields">
    {%- if needs_file -%}
      <div class="audio-keepsake-cart__field" data-role="file">
        <div class="audio-keepsake-cart__label-row">
          <label class="audio-keepsake-cart__label" for="AudioFile-{{ line_index }}">Fichier audio</label>
        </div>
        <input
          id="AudioFile-{{ line_index }}"
          class="audio-keepsake-cart__file-input visually-hidden"
          type="file"
          accept="audio/*,.mp3,.wav,.m4a,.aac,.ogg,.flac"
          data-file-input
        >
        <label
          for="AudioFile-{{ line_index }}"
          class="audio-keepsake-cart__file-trigger"
          data-file-trigger
        >
          <span class="audio-keepsake-cart__file-trigger-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 16V4"/>
              <path d="M6 10l6-6 6 6"/>
              <path d="M4 20h16"/>
            </svg>
          </span>
          <span class="audio-keepsake-cart__file-trigger-text" data-file-trigger-label>
            {%- if existing_file != blank -%}
              Remplacer le fichier
            {%- else -%}
              Choisir un fichier audio
            {%- endif -%}
          </span>
        </label>
        <p class="audio-keepsake-cart__file-hint">MP3, WAV, M4A — 100 Mo max</p>
        <div class="audio-keepsake-cart__upload-progress" data-upload-progress hidden>
          <div class="audio-keepsake-cart__upload-bar">
            <div class="audio-keepsake-cart__upload-fill" data-upload-fill></div>
          </div>
          <span class="audio-keepsake-cart__upload-label" data-upload-label>Envoi en cours...</span>
        </div>
        <div class="audio-keepsake-cart__saved" data-file-saved-state>
          {%- if existing_file != blank -%}
            <span class="audio-keepsake-cart__saved-label">Fichier enregistré</span>
            {%- if existing_file contains 'https://' or existing_file contains 'http://' -%}
              <a href="{{ existing_file }}" class="link" target="_blank" rel="noopener">{{ existing_file | split: '/' | last | split: '?' | first }}</a>
            {%- else -%}
              <span>{{ existing_file }}</span>
            {%- endif -%}
          {%- else -%}
            <span class="audio-keepsake-cart__saved-label">Aucun fichier enregistré pour le moment</span>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- if needs_brief -%}
      <div class="audio-keepsake-cart__field" data-role="brief">
        <div class="audio-keepsake-cart__label-row">
          <label class="audio-keepsake-cart__label" for="CreativeBrief-{{ line_index }}">Votre brief créatif</label>
          <details class="audio-keepsake-cart__tooltip">
            <summary aria-label="Comment utiliser les inspirations de brief">i</summary>
            <div class="audio-keepsake-cart__tooltip-content">
              Choisissez une occasion, parcourez les inspirations avec les flèches, puis adaptez celle qui vous ressemble en remplaçant les éléments entre crochets.
            </div>
          </details>
        </div>
        <p class="audio-keepsake-cart__helper">
          Racontez-nous à qui s’adresse la chanson, l’émotion recherchée, le style, la voix et les détails à glisser dans les paroles.
        </p>

        <div class="audio-keepsake-cart__brief-templates" data-brief-template-picker aria-label="Inspirations de brief créatif">
          <p class="audio-keepsake-cart__brief-templates-label">Choisir une inspiration</p>
          <div class="audio-keepsake-cart__brief-categories" role="tablist" aria-label="Occasions">
            <button type="button" role="tab" class="audio-keepsake-cart__brief-category" data-brief-category-button data-brief-category-index="0" aria-selected="false">Anniversaire</button>
            <button type="button" role="tab" class="audio-keepsake-cart__brief-category" data-brief-category-button data-brief-category-index="1" aria-selected="false">Amour</button>
            <button type="button" role="tab" class="audio-keepsake-cart__brief-category" data-brief-category-button data-brief-category-index="2" aria-selected="false">Naissance</button>
            <button type="button" role="tab" class="audio-keepsake-cart__brief-category" data-brief-category-button data-brief-category-index="3" aria-selected="false">Mariage</button>
            <button type="button" role="tab" class="audio-keepsake-cart__brief-category" data-brief-category-button data-brief-category-index="4" aria-selected="false">Amitié</button>
            <button type="button" role="tab" class="audio-keepsake-cart__brief-category" data-brief-category-button data-brief-category-index="5" aria-selected="false">Famille</button>
            <button type="button" role="tab" class="audio-keepsake-cart__brief-category" data-brief-category-button data-brief-category-index="6" aria-selected="false">Hommage</button>
            <button type="button" role="tab" class="audio-keepsake-cart__brief-category" data-brief-category-button data-brief-category-index="7" aria-selected="false">Merci</button>
          </div>
          <div class="audio-keepsake-cart__brief-card" data-brief-template-card hidden>
            <div class="audio-keepsake-cart__brief-card-header">
              <span data-brief-template-label>Anniversaire</span>
              <span data-brief-template-counter>1 / 4</span>
            </div>
            <p class="audio-keepsake-cart__brief-preview" data-brief-template-preview></p>
            <div class="audio-keepsake-cart__brief-actions">
              <div class="audio-keepsake-cart__brief-nav">
                <button type="button" class="audio-keepsake-cart__brief-nav-button" data-brief-template-prev aria-label="Voir l’inspiration précédente">‹</button>
                <button type="button" class="audio-keepsake-cart__brief-nav-button" data-brief-template-next aria-label="Voir l’inspiration suivante">›</button>
              </div>
              <button type="button" class="audio-keepsake-cart__brief-apply" data-brief-template-apply>Utiliser ce brief</button>
            </div>
          </div>
          <template data-brief-template-data>
            <div data-brief-template-category="Anniversaire">
              <p data-brief-template-choice>Pour les 30 ans de [prénom], mon meilleur ami depuis le lycée. J’aimerais quelque chose de festif et un peu drôle, façon funk ou disco, avec un refrain qu’on puisse chanter tous ensemble le soir de la fête. À glisser dans les paroles : [son surnom] et [une anecdote entre nous].</p>
              <p data-brief-template-choice>C’est l’anniversaire de ma mère, [prénom], qui aura [âge] ans. Elle adore la chanson française des années 70. Une mélodie douce, au piano, qui parle de [ce qu’elle nous a transmis] et de [un lieu qui compte pour elle].</p>
              <p data-brief-template-choice>Surprise pour les 18 ans de ma fille [prénom]. Un son actuel et lumineux, entre pop et afro, qui lui donne confiance pour la suite. Pas trop sentimental, plutôt fier et joyeux. Elle rêve de [son projet ou sa passion].</p>
              <p data-brief-template-choice>Pour les 60 ans de [prénom], passionné de jazz. Une ambiance de club feutré, contrebasse et saxophone, voix chaude. Évoquer [ses voyages, son métier ou sa passion] avec une pointe d’humour, sans jamais parler de vieillir.</p>
            </div>
            <div data-brief-template-category="Amour">
              <p data-brief-template-choice>Une chanson pour [prénom], pour nos 10 ans ensemble. On s’est rencontrés à [lieu], un soir de [saison]. J’aimerais une ballade acoustique, guitare et voix, sincère et sans clichés. Il y a une phrase qu’on se dit souvent : « [phrase] ».</p>
              <p data-brief-template-choice>Je veux déclarer ma flamme à [prénom]. Une bossa-nova légère et ensoleillée, un peu rétro, qui sourit plus qu’elle ne pleure. Quelques mots en portugais dans le refrain seraient parfaits.</p>
              <p data-brief-template-choice>Pour [prénom], qui vit loin de moi en ce moment. Un titre R&amp;B lent et intime, avec une voix [féminine / masculine]. Le thème : la distance, les appels du soir et le jour où l’on se retrouvera à [ville].</p>
              <p data-brief-template-choice>Chanson pour la Saint-Valentin de [prénom]. Style soul des années 60, cuivres et chœurs, joyeux et élégant à la fois. Parler de nos petits rituels : [le café du dimanche, une chanson fétiche, un surnom…].</p>
            </div>
            <div data-brief-template-category="Naissance">
              <p data-brief-template-choice>Une berceuse pour [prénom du bébé], né(e) le [date]. Très douce, boîte à musique et voix feutrée, pour l’endormir le soir. Les prénoms des parents : [prénoms]. On aimerait qu’elle parle de [la lumière, les étoiles, la mer…].</p>
              <p data-brief-template-choice>Cadeau de naissance pour mes amis [prénoms des parents]. Quelque chose de folk et lumineux, ukulélé et sifflements, qui célèbre l’arrivée de [prénom du bébé] sans être enfantin. Les parents se sont rencontrés à [lieu].</p>
              <p data-brief-template-choice>Pour accueillir notre deuxième enfant, [prénom]. On voudrait que son grand frère ou sa grande sœur, [prénom], soit aussi dans la chanson. Style comptine moderne, piano et petites percussions, tendre et joyeux.</p>
              <p data-brief-template-choice>Une chanson pour notre petit-enfant, [prénom], de la part de ses grands-parents. Une valse lente, un peu à l’ancienne, accordéon et cordes douces. Le message : nous serons toujours là pour toi.</p>
            </div>
            <div data-brief-template-category="Mariage">
              <p data-brief-template-choice>Pour le mariage de [prénom] et [prénom], le [date] à [lieu]. Une ballade pop qui monte doucement jusqu’à un grand final, pour l’entrée des mariés. Leur histoire : [comment ils se sont rencontrés].</p>
              <p data-brief-template-choice>Cadeau de témoin pour [prénom] et [prénom]. Un titre festif, esprit gospel ou soul, qui donne envie de taper dans les mains. Glisser quelques clins d’œil : [souvenirs d’amis, surnoms, voyage commun].</p>
              <p data-brief-template-choice>Pour notre première danse. Nous aimons le jazz manouche et les guinguettes : guitare, violon, ambiance chaleureuse et intemporelle. Le refrain pourrait reprendre nos vœux : « [phrase] ».</p>
              <p data-brief-template-choice>Pour les noces d’or de mes parents, [prénoms], mariés depuis 50 ans. Chanson française élégante, orchestre léger, qui raconte leur vie à deux : [la maison, les enfants, les voyages].</p>
            </div>
            <div data-brief-template-category="Amitié">
              <p data-brief-template-choice>Pour [prénom], mon amie depuis la maternelle, qui part vivre à [ville]. Une chanson pop-rock un peu nostalgique mais pleine d’énergie, sur tout ce qu’on a traversé ensemble : [trois souvenirs].</p>
              <p data-brief-template-choice>Chanson pour notre bande d’amis, à écouter pendant nos retrouvailles de chaque été. Style reggae ou ska, ensoleillé et plein d’humour. Nos surnoms : [surnoms]. Le lieu de nos vacances : [lieu].</p>
              <p data-brief-template-choice>Pour remonter le moral de [prénom], qui traverse une période difficile. Un titre doux et plein d’espoir, guitare et voix, qui lui rappelle qu’on est là. Sans jamais nommer ce qui ne va pas.</p>
              <p data-brief-template-choice>Pour l’enterrement de vie de jeune fille ou de garçon de [prénom]. Un morceau électro-pop dansant et complice, avec des paroles pleines de clins d’œil : [anecdotes à glisser]. Rien de gênant devant la famille.</p>
            </div>
            <div data-brief-template-category="Famille">
              <p data-brief-template-choice>Pour la fête des pères. Mon père, [prénom], adore le blues et la country. Un morceau guitare et harmonica, chaleureux, qui parle de [la pêche, le bricolage, les dimanches…] et le remercie à sa façon.</p>
              <p data-brief-template-choice>Pour la fête des mères, de la part de [prénoms des enfants]. Une chanson tendre, piano et cordes, dans l’esprit de la variété française d’aujourd’hui. Chacun aimerait y avoir sa petite phrase : [phrases].</p>
              <p data-brief-template-choice>Pour les 90 ans de ma grand-mère, [prénom], née à [région ou pays]. Si possible avec des sonorités de chez elle : [instrument, langue, musique traditionnelle]. Évoquer [sa cuisine, son jardin, ses histoires].</p>
              <p data-brief-template-choice>Chanson pour réunir toute la famille à Noël. Joyeuse, un peu jazzy, avec clochettes et chœurs. Mentionner tout le monde : [prénoms], et la maison de [lieu] où l’on se retrouve chaque année.</p>
            </div>
            <div data-brief-template-category="Hommage">
              <p data-brief-template-choice>En mémoire de mon père, [prénom], qui aimait [sa passion]. Une chanson sobre et apaisée, guitare et violoncelle, qui célèbre sa vie plutôt que son absence. Il répétait souvent : « [phrase] ».</p>
              <p data-brief-template-choice>Pour garder le souvenir de [prénom], partie trop tôt. Un morceau lumineux, presque aérien, sur ce qu’elle nous a laissé : [son rire, sa force, ses mots]. À écouter en famille, sans lourdeur.</p>
              <p data-brief-template-choice>Hommage à mon grand-père, [prénom], ancien [métier]. Une chanson à l’ancienne, accordéon et voix grave, qui raconte sa vie : [son village, son métier, sa famille].</p>
              <p data-brief-template-choice>Pour notre compagnon à quatre pattes, [nom], qui a partagé [nombre] années de notre vie. Une petite chanson tendre et un peu drôle, pleine de ses habitudes : [ses manies, ses endroits préférés].</p>
            </div>
            <div data-brief-template-category="Merci">
              <p data-brief-template-choice>Pour le départ à la retraite de [prénom], après [nombre] ans dans l’équipe. Un titre festif et chaleureux, esprit funk ou variété, avec des clins d’œil au bureau : [anecdotes, expressions fétiches].</p>
              <p data-brief-template-choice>Pour remercier [prénom], la nounou de nos enfants depuis [nombre] ans. Une chanson douce et reconnaissante, où les enfants lui disent merci : [prénoms des enfants].</p>
              <p data-brief-template-choice>Pour notre professeur, [prénom], de la part de toute la classe. Une chanson pop entraînante, avec un refrain simple que les élèves pourront chanter. À glisser : [matière, expression fétiche, sortie de classe].</p>
              <p data-brief-template-choice>Pour dire merci à [prénom], qui a été là pendant [l’épreuve ou le projet]. Une ballade soul, sincère et sans excès, sur ce que sa présence a changé pour moi.</p>
            </div>
          </template>
        </div>

        <textarea
          id="CreativeBrief-{{ line_index }}"
          class="audio-keepsake-cart__input audio-keepsake-cart__input--textarea"
          rows="6"
          placeholder="Décrivez le destinataire, les prénoms, le contexte, le style musical souhaité, la voix, l'ambiance, les mots à intégrer et les éléments à éviter."
          data-brief-input
        >{{ existing_brief }}</textarea>
      </div>
    {%- endif -%}

    <div class="audio-keepsake-cart__field">
      <div class="audio-keepsake-cart__label-row">
        <label class="audio-keepsake-cart__label" for="AdditionalNotes-{{ line_index }}">Notes</label>
        <details class="audio-keepsake-cart__tooltip">
          <summary aria-label="Voir un exemple de notes complémentaires">i</summary>
          <div class="audio-keepsake-cart__tooltip-content">
            Exemple : éviter une voix trop solennelle, mentionner la date du 12 juin, garder un ton intime et rassurant.
          </div>
        </details>
      </div>
      <textarea
        id="AdditionalNotes-{{ line_index }}"
        class="audio-keepsake-cart__input audio-keepsake-cart__input--textarea audio-keepsake-cart__input--compact"
        rows="4"
        placeholder="Ajoutez ici un contexte utile, une date importante, une contrainte ou une attention particulière."
        data-notes-input
      >{{ existing_notes }}</textarea>
    </div>
  </div>

  <div class="audio-keepsake-cart__footer">
    <p class="audio-keepsake-cart__message" data-form-message hidden></p>
    <button type="button" class="button audio-keepsake-cart__save-btn" data-save-button>
      {%- if line_complete -%}
        Mettre à jour
      {%- else -%}
        Enregistrer
      {%- endif -%}
    </button>
  </div>
</audio-keepsake-cart-panel>
